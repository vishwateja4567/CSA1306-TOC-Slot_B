//Experiment 7: CFG — S → A101A, A → 0A | 1A | ε
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 0;

    printf("Enter a string: ");
    scanf("%99s", s);

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            break;
    }

    if (s[i] == '\0' && strstr(s, "101") != NULL)
        valid = 1;

    if (valid)
        printf("String belongs to CFG\n");
    else
        printf("String does not belong to CFG\n");

    return 0;
}
