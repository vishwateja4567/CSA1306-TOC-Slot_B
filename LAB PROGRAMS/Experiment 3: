//Experiment 3: CFG — S → 0A1, A → 0A | 1A | ε
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    if (strlen(s) < 2 || s[0] != '0' ||
        s[strlen(s) - 1] != '1')
        valid = 0;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("String belongs to CFG\n");
    else
        printf("String does not belong to CFG\n");

    return 0;
}
