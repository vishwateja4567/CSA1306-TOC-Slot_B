//Experiment 5: CFG — S → 0S0 | A, A → 1A | ε
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i = 0, j, valid = 1;
    int zeros = 0;

    printf("Enter a string: ");
    scanf("%99s", s);

    j = strlen(s) - 1;

    while (i < (int)strlen(s) && s[i] == '0') {
        i++;
        zeros++;
    }

    while (j >= i && s[j] == '0') {
        j--;
    }

    for (int k = i; k <= j; k++) {
        if (s[k] != '1')
            valid = 0;
    }

    if (zeros != (int)strlen(s) - 1 - j)
        valid = 0;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("String belongs to CFG\n");
    else
        printf("String does not belong to CFG\n");

    return 0;
}
