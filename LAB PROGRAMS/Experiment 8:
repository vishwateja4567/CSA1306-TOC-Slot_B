//Experiment 8: NFA — Strings that start with b and end with a
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    if (s[0] != 'b' || s[strlen(s) - 1] != 'a')
        valid = 0;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != 'a' && s[i] != 'b')
            valid = 0;
    }

    if (valid)
        printf("Accepted by NFA\n");
    else
        printf("Rejected by NFA\n");

    return 0;
}
