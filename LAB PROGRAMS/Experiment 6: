//Experiment 6: CFG — S → 0S1 | ε
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i = 0, j, valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    j = strlen(s) - 1;

    while (i < (int)strlen(s) && s[i] == '0')
        i++;

    while (j >= 0 && s[j] == '1')
        j--;

    if (i != j + 1)
        valid = 0;

    if (i != (int)strlen(s) / 2)
        valid = 0;

    for (int k = 0; k < (int)strlen(s); k++) {
        if (s[k] != '0' && s[k] != '1')
            valid = 0;
    }

    if (valid)
        printf("String belongs to CFG\n");
    else
        printf("String does not belong to CFG\n");

    return 0;
}
