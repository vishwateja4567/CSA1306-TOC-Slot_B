//Experiment 4: CFG — S → 0S0 | 1S1 | 0 | 1 | ε
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, j, valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    i = 0;
    j = strlen(s) - 1;

    while (i < j) {
        if (s[i] != s[j]) {
            valid = 0;
            break;
        }
        i++;
        j--;
    }

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (valid)
        printf("String belongs to CFG\n");
    else
        printf("String does not belong to CFG\n");

    return 0;
}
