//Experiment 2: DFA — Strings that start with 0 and end with 1
#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int i, valid = 1;

    printf("Enter a string: ");
    scanf("%99s", s);

    if (s[0] != '0')
        valid = 0;

    for (i = 0; s[i] != '\0'; i++) {
        if (s[i] != '0' && s[i] != '1')
            valid = 0;
    }

    if (s[strlen(s) - 1] != '1')
        valid = 0;

    if (valid)
        printf("Accepted by DFA\n");
    else
        printf("Rejected by DFA\n");

    return 0;
}
